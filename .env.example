# ========================================
# HydraFlow AI 环境变量配置
# 复制此文件为 .env 并填入你的配置
# ========================================

# ========================================
# 运行环境
# ========================================
ENVIRONMENT=development  # development / production / staging
DEBUG=true

# ========================================
# API 服务配置
# ========================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
RELOAD=true

# ========================================
# UI 服务配置
# ========================================
UI_HOST=localhost
UI_PORT=3000

# ========================================
# 数据库配置
# ========================================
# SQLite (默认/开发环境)
DATABASE_URL=sqlite+aiosqlite:///./data/hydraflow.db

# PostgreSQL (生产环境)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/hydraflow
# DATABASE_POOL_SIZE=20
# DATABASE_MAX_OVERFLOW=10

# ========================================
# Redis 配置 (缓存/任务队列)
# ========================================
REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://:password@localhost:6379/0
REDIS_POOL_SIZE=10
REDIS_MAX_CONNECTIONS=50

# ========================================
# Celery 任务队列配置
# ========================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=Asia/Shanghai
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600  # 1小时
CELERY_TASK_SOFT_TIME_LIMIT=3000  # 50分钟

# ========================================
# 对象存储配置
# ========================================
STORAGE_TYPE=local  # local / minio / s3

# 本地存储
LOCAL_STORAGE_PATH=./data/storage

# MinIO
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=hydraflow
# MINIO_SECURE=false

# S3 (AWS)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_BUCKET=hydraflow

# ========================================
# 认证与安全
# ========================================
# JWT 密钥 (生产环境请使用强随机密钥)
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth2 配置 (可选)
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# CORS 配置
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ========================================
# API 限流配置
# ========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTHENTICATED=1000/minute

# ========================================
# 模型配置
# ========================================
DEFAULT_PARSER=qwen2.5
DEFAULT_STYLE=cyberpunk

# ========================================
# API 密钥
# ========================================
OPENAI_API_KEY=
STABILITY_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=
REPLICATE_API_KEY=

# ========================================
# 本地部署
# ========================================
LM_STUDIO_API_BASE=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=qwen2.5-7b

OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# ========================================
# 技能市场
# ========================================
SKILL_MARKET_URL=https://hydraflow-ai.org/market

# ========================================
# 监控与日志
# ========================================
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FORMAT=json  # json / text

# Prometheus 指标
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ========================================
# 缓存配置
# ========================================
CACHE_TTL=3600  # 秒
CACHE_MAX_SIZE=10000
CACHE_DEFAULT_NAMESPACE=hydraflow

# ========================================
# 任务执行配置
# ========================================
TASK_MAX_RETRIES=3
TASK_RETRY_DELAY=5  # 秒
TASK_TIMEOUT=3600  # 秒
TASK_CONCURRENCY=10
