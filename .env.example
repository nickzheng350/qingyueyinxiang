# HydraFlow AI 环境变量配置
# 复制此文件为 .env 并填入你的配置

# === API 服务配置 ===
API_HOST=0.0.0.0
API_PORT=8000

# === UI 服务配置 ===
UI_HOST=localhost
UI_PORT=3000

# === 模型配置 ===
DEFAULT_PARSER=qwen2.5
DEFAULT_STYLE=cyberpunk

# === API 密钥 ===
OPENAI_API_KEY=
STABILITY_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=
REPLICATE_API_KEY=

# === 本地部署 ===
LM_STUDIO_API_BASE=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=qwen2.5-7b

OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# === 技能市场 ===
SKILL_MARKET_URL=https://hydraflow-ai.org/market

# === 日志 ===
LOG_LEVEL=INFO
LOG_DIR=./logs
