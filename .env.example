# ===========================================
# HydraFlow AI - 环境变量配置示例
# ===========================================
# 复制此文件为 .env 并填入实际值
# 所有密钥也可以配置在 config/api_keys.json 中

# --------- API Keys ---------

# OpenAI API (GPT-4, GPT-3.5)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# Anthropic API (Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_API_BASE=https://api.anthropic.com/v1

# 阿里云 Dashscope (通义千问)
# 申请地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Hugging Face
HUGGINGFACE_API_KEY=hf-your-huggingface-api-key-here

# Google (Gemini, etc.)
GOOGLE_API_KEY=your-google-api-key-here

# Replicate
REPLICATE_API_KEY=your-replicate-api-key-here


# --------- 本地模型服务 ---------

# LM Studio
# 启动 LM Studio 后默认 API 地址
LM_STUDIO_API_BASE=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=qwen2.5-7b

# Ollama
# 确保已运行: ollama run llama3
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_MODEL=llama3


# --------- 应用配置 ---------

# Flask/FastAPI 服务配置
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# 数据库 (SQLite 默认)
DATABASE_URL=sqlite:///hydraflow.db

# 日志级别
LOG_LEVEL=INFO

# JWT 密钥 (生产环境请修改)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS 配置
CORS_ORIGINS=http://localhost:3000,http://localhost:5173